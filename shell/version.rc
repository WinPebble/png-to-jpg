#include <windows.h>
#include "../resources/build-version.h"
VS_VERSION_INFO VERSIONINFO
 FILEVERSION WP_NUMERIC_VERSION
 PRODUCTVERSION WP_NUMERIC_VERSION
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0
 FILEOS VOS__WINDOWS32
 FILETYPE VFT_DLL
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904b0"
  BEGIN
   VALUE "CompanyName", "WinPebble\0"
   VALUE "FileDescription", "WinPebble PNG to JPG Explorer command\0"
   VALUE "FileVersion", WP_FILE_VERSION
   VALUE "ProductName", "WinPebble PNG to JPG\0"
   VALUE "ProductVersion", WP_PRODUCT_VERSION
   VALUE "OriginalFilename", "WinPebble.PNGToJPG.Shell.dll\0"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x0409, 1200
 END
END
